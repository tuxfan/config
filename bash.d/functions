function print_env_var() {
  if [[ -z "${BASHRC_SILENT}" ]] ; then
	  echo -e "$FG_21""$1""$NEUTRAL""=""$FG_39""$2""$NEUTRAL"
  fi
} # print_env_var

function prepend_path() {
	if [ -z "$PATH" ] ; then
		export PATH=$1
	else
		export PATH=$1:"${PATH}"
	fi
} # prepend_path

function append_path() {
	if [ -z "$PATH" ] ; then
		export PATH=$1
	else
		export PATH=$PATH:$1
	fi
} # append_path

function prepend_manpath() {
	if [ -z "$MANPATH" ] ; then
		export MANPATH=$1
	else
		export MANPATH=$1:$MANPATH
	fi
} # prepend_manpath

function append_manpath() {
	if [ -z "$MANPATH" ] ; then
		export MANPATH=$1
	else
		export MANPATH=$MANPATH:$1
	fi
} # append_manpath

function prepend_ld_library_path() {
	if [ -z "$LD_LIBRARY_PATH" ] ; then
		export LD_LIBRARY_PATH=$1
	else
		export LD_LIBRARY_PATH=$1:$LD_LIBRARY_PATH
	fi
} # prepend_ld_library_path

function append_ld_library_path() {
	if [ -z "$LD_LIBRARY_PATH" ] ; then
		export LD_LIBRARY_PATH=$1
	else
		export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:$1
	fi
} # append_ld_library_path

function set_http_proxy() {
	if [[ "$1" = *LANL* ]] ; then
		echo -e "Setting LANL network proxy..."
		export RSYNC_PROXY=proxyout.lanl.gov:8080
		export http_proxy=proxyout.lanl.gov:8080
		export proxy_http=proxyout.lanl.gov:8080
		export https_proxy=proxyout.lanl.gov:8080
		export proxy_https=proxyout.lanl.gov:8080
	fi
}

glab_lanl() {
    local tunnel_jump="m4"
    local tunnel_socket="$HOME/.ssh/glab-lanl.sock"

    if ! ssh -S "$tunnel_socket" -O check "$tunnel_jump" \
            >/dev/null 2>&1; then
        ssh -M -S "$tunnel_socket" \
            -o ControlPersist=10m \
            -o ExitOnForwardFailure=yes \
            -o ServerAliveInterval=30 \
            -o ServerAliveCountMax=3 \
            -fN -D 127.0.0.1:1080 "$tunnel_jump" || return
    fi

    GITLAB_HOST=re-git.lanl.gov \
    GLAB_PROXY=socks5h://127.0.0.1:1080 \
        command glab "$@"
}

